# LLM Provider — matches config/config.yaml (provider: ollama-cloud, model: deepseek-v4-pro)
# Get your API key at https://ollama.com/settings/keys
# OLLAMA_API_KEY=...

# Alternative: OpenRouter (change config.yaml provider to "openrouter" and uncomment below)
# OPENROUTER_API_KEY=sk-or-...

# Optional: Docker sandbox (only if terminal.backend = docker)
# DOCKER_HOST=unix:///var/run/docker.sock

# Optional: Gateway platforms (uncomment and fill in to activate)
# See config/telegram.md and config/discord.md for full step-by-step setup guides.
#
# Telegram: message @BotFather on Telegram → /newbot → copy the token
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
#
# Discord: https://discord.com/developers/applications → New Application → Bot → Reset Token → copy
# Enable "Message Content Intent" and "Server Members Intent" under Privileged Gateway Intents.
# DISCORD_BOT_TOKEN=MTIzNDU2Nzg5...
# Slack: https://api.slack.com/apps → Create New App → From scratch
#   1. Under "OAuth & Permissions", add scopes: chat:write, channels:history, app_mentions:read
#   2. Install to workspace → copy "Bot User OAuth Token" (xoxb-...)
#   3. Under "Socket Mode", enable it → copy "App-Level Token" (xapp-...) with connections:write scope
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# Signal: requires signal-cli setup
# SIGNAL_PHONE=+123****7890
# WhatsApp: requires Meta Business app
# WHATSAPP_TOKEN=...
# WHATSAPP_PHONE_ID=...
# Email (SMTP):
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=...
# EMAIL_PASSWORD=...

# Optional: Honcho memory provider (cloud: https://api.honcho.dev, or self-hosted)
# Get your key at https://app.honcho.dev → Settings → API Keys
# HONCHO_API_KEY=hn-...

# Optional: xAI Grok (v2026.8.1+ — Cursor Composer provider)
# Get your key at https://console.x.ai
# XAI_GROK_API_KEY=xai-...
